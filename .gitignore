# ============================================================
# MP-Raman-DLReg · 仓库体积控制
# 原则:代码、配置、论文稿件、关键结果表入库;
#       原始数据、可重建产物、大体积二进制、归档垃圾不入库。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Jupyter Notebook
.ipynb_checkpoints/

# 日志文件
logs/
*.log

# 临时文件
*.tmp
*.temp
.cache/

# 系统文件
.DS_Store
Thumbs.db

# 本地配置覆盖
config.local.yaml
.env
.env.local

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# MyPy
.mypy_cache/

# Spec workflow / Serena 临时文件
.spec-workflow/
.serena/

# nul 文件 (Windows)
nul
_nul

# Pandoc 安装包
pandoc-*.msi

# Word 临时锁文件
~$*

# 本地工具/编辑器产生的项目数据,不属于项目内容
.playwright-mcp/

# ============================================================
# 【1】原始数据集:836M / 30425 文件,含单文件 13M 的 .mic
#      数据由实验仪器采集,不通过代码生成,故不入库
# ============================================================
dataset/

# 像素级参考真值标签(GT),由 NNLS 丰度阈值生成,属研究数据。
# 代码仍保留,复现评估时在本地放回该目录即可。
testing/test_true_label/

# ============================================================
# 【2】预处理中间产物:163M
#      可由 preprocessing/preprocess.py 完整重建
# ============================================================
preprocessed_data/

# ============================================================
# 【3】实验输出产物:467M
#      全部为程序运行产物,可由脚本重新生成;
#      含 .npy 丰度矩阵、预测概率 CSV、混淆矩阵、Grad-CAM 等实验结果,
#      属于未公开研究数据,不得进入公开仓库。
# ============================================================
output/

# ============================================================
# 【4】论文目录:540K
#      含未发表稿件(JHMlaster 系列)、投稿信、声明、正文提取文本与图形摘要,
#      属于未公开成果,不得进入公开仓库。
# ============================================================
paper/

# ============================================================
# 【5】对话记录:含完整研究讨论过程,不入公开仓库
# ============================================================
对话记录/

# ============================================================
# 【6】归档与无关内容(本地保留,不入库)
# ============================================================
Codex/
Pic/
暂放/

# 第三方已发表论文 PDF:39M 且涉及版权,仅本地参考
reference_paper/
